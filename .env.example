# Free option (recommended): Gemini API key from https://aistudio.google.com/apikey
# When set, Gemini writes the stories and provides free downloadable voices.
GEMINI_API_KEY=

# Paid alternative: Anthropic API key (used only when GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=

# Optional: ElevenLabs key for an extra voice engine (MP3)
ELEVENLABS_API_KEY=

# Optional: API port (default 3001; the Next.js app proxies to it)
PORT=3001
